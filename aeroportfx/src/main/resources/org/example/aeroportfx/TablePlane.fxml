<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.aeroportfx.controller.TablePlaneController">
    <top>
        <VBox>
            <HBox alignment="CENTER" spacing="20">
                <Label text="Минский Национальный Аэропорт" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: gray; -fx-font-style: italic; -fx-rotate: 0;">
                    <font>
                        <Font name="Algerian" size="9.0" />
                    </font>
                </Label>
                <Pane HBox.hgrow="ALWAYS" />
                <Button onAction="#switchLanguage" text="RU" />
                <Button fx:id="menuButton" onAction="#toggleMenu" text="Меню" />
            </HBox>
            <HBox alignment="CENTER" prefHeight="184.0" prefWidth="900.0" spacing="20" style="-fx-padding: 10;">
                <Label fx:id="arrivalLabel" onMouseClicked="#showArrivals" style="-fx-font-size: 30px; -fx-text-fill: black; -fx-background-color: white; -fx-text-fill: black; -fx-border-width: 2;" text="Табло рейсов" />
            </HBox>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="542.0" prefWidth="900.0">
            <TableView fx:id="flightTable" prefHeight="370.0" prefWidth="698.0">
                <columns>
                    <TableColumn fx:id="flightNumberColumn" prefWidth="152.7999786734581" text="Номер рейса" />
                    <TableColumn fx:id="cityOfRegistrationColumn" prefWidth="152.7999786734581" text="Город регистрации" />
                    <TableColumn fx:id="cityOfDestinationColumn" prefWidth="192.00001525878906" text="Город назначения" />
                    <TableColumn fx:id="statusColumn" prefWidth="176.00003051757812" text="Статус" />
                    <TableColumn fx:id="departureTimeColumn" prefWidth="175.19998779296873" text="Время отправления" />
                    <TableColumn fx:id="arrivalTimeColumn" prefWidth="175.19998779296873" text="Время прибытия" />
                </columns>
            </TableView>
        </ScrollPane>
    </center>
    <right>
        <VBox fx:id="menuPane" prefWidth="200" style="-fx-background-color: white;" spacing="15" visible="false">
            <Button onAction="#buyTicket" text="Купить билет" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-text-fill: black;" />
            <Button onAction="#goHome" text="Главная" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-text-fill: black;" />
            <Button onAction="#showArrivals" text="Табло рейсов" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-text-fill: black;" />
            <Button onAction="#showServices" text="Услуги" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-text-fill: black;" />
            <HBox spacing="10">
                <Button onAction="#toggleCompanyInfo" text="О компании" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-text-fill: black;" />
                <Button onAction="#toggleCompanyInfo" text="+" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-text-fill: black;" />
            </HBox>
            <VBox fx:id="companyInfo" visible="false">
                <Label text="Содержимое о компании..." />
            </VBox>
        </VBox>
    </right>
</BorderPane>

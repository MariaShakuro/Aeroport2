<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Pos?>

<StackPane xmlns="http://javafx.com/javafx/8.0.111" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.aeroportfx.controller.SuccessBookingVBoxController" style="-fx-background-color: lightgrey;">
        <VBox fx:id="successBookingVBox" alignment="CENTER" spacing="10" visible="true" style="-fx-background-color: white; -fx-background-radius: 20; -fx-border-color: grey; -fx-border-radius: 20; -fx-border-width: 1;" VBox.vgrow="ALWAYS" prefHeight="200" prefWidth="300">
            <Label text="Вы успешно забронировали место" />
            <Label text="Выберите формат билета" />
            <VBox>
                <RadioButton fx:id="TXT" text="TXT" toggleGroup="$formatToggleGroup" />
                <RadioButton fx:id="JSON" text="JSON" toggleGroup="$formatToggleGroup" />
                <RadioButton fx:id="XML" text="XML" toggleGroup="$formatToggleGroup" />
                <RadioButton fx:id="YAML" text="YAML" toggleGroup="$formatToggleGroup" />
            </VBox>
            <TextField fx:id="emailTextField" promptText="Адрес электронной почты" />
            <Button fx:id="deliver" text="Отправить" onAction="#sendEmail" style="-fx-background-color: lightgrey; -fx-background-radius: 20;" />
        </VBox>
</StackPane>
